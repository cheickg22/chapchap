    /**
     * Get Moov Money request details for driver
     * 
     * @param string $requestId
     * @return \Illuminate\Http\JsonResponse
     */
    public function getRequestDetails($requestId)
    {
        $driver = auth()->user()->driver;

        $moovRequest = Request::with(['moovMoneyTransaction', 'requestPlace', 'userDetail'])
            ->where('id', $requestId)
            ->where('driver_id', $driver->id)
            ->where('is_moov_money', 1)
            ->first();

        if (!$moovRequest) {
            return $this->respondNotFound('Requête non trouvée');
        }

        return $this->respondSuccess([
            'request' => $moovRequest,
            'transaction' => $moovRequest->moovMoneyTransaction,
            'user' => $moovRequest->userDetail,
            'location' => $moovRequest->requestPlace,
        ], 'Détails de la requête Moov Money');
    }
    
    /**
     * Driver cancels a Moov Money request
     * 
     * @param HttpRequest $request
     * @return \Illuminate\Http\JsonResponse
     */
    public function cancelRequest(HttpRequest $request)
    {
        $validator = Validator::make($request->all(), [
            'request_id' => 'required|uuid',
            'reason' => 'required|string|max:500',
        ]);

        if ($validator->fails()) {
            return $this->respondBadRequest('Validation failed', $validator->errors());
        }

        $driver = auth()->user()->driver;
        $requestId = $request->request_id;
        $reason = $request->reason;

        // Vérifier que la requête existe et est assignée au driver
        $moovRequest = Request::where('id', $requestId)
            ->where('driver_id', $driver->id)
            ->where('is_moov_money', 1)
            ->first();

        if (!$moovRequest) {
            return $this->respondNotFound('Requête non trouvée ou non assignée à ce driver');
        }

        if ($moovRequest->moov_money_status === 'completed') {
            return $this->respondBadRequest('Cette transaction a déjà été complétée');
        }

        if ($moovRequest->moov_money_status === 'cancelled') {
            return $this->respondBadRequest('Cette transaction a déjà été annulée');
        }

        DB::beginTransaction();
        try {
            // Mettre à jour le statut
            $moovRequest->moov_money_status = 'cancelled';
            $moovRequest->is_cancelled = 1;
            $moovRequest->cancel_reason = $reason;
            $moovRequest->cancelled_at = Carbon::now();
            $moovRequest->save();

            // Mettre à jour la transaction Moov Money
            $moovTransaction = $moovRequest->moovMoneyTransaction;
            $moovTransaction->status = 'cancelled';
            $moovTransaction->error_message = 'Annulée par le driver: ' . $reason;
            $moovTransaction->save();
            
            // Notifier le user de l'annulation
            $this->notifyUserStatusChange(
                $moovRequest, 
                'cancelled', 
                'Transaction annulée par le driver: ' . $reason
            );
            
            // Supprimer la requête de Firebase
            $this->removeRequestFromFirebase($moovRequest);

            DB::commit();

            Log::info('Driver cancelled Moov Money request', [
                'request_id' => $requestId,
                'driver_id' => $driver->id,
                'reason' => $reason,
                'type' => $moovRequest->moov_money_type,
            ]);

            return $this->respondSuccess([
                'request' => $moovRequest,
            ], 'Transaction annulée avec succès');

        } catch (\Exception $e) {
            DB::rollBack();
            
            Log::error('Driver failed to cancel Moov Money request', [
                'error' => $e->getMessage(),
                'request_id' => $requestId,
                'driver_id' => $driver->id,
            ]);

            return $this->respondInternalError('Erreur lors de l\'annulation: ' . $e->getMessage());
        }
    }
    
    /**
     * Mettre à jour le statut Firebase pour une requête Moov Money
     * 
     * @param Request $request
     * @param string $status
     * @param string $message
     * @return void
     */
    private function updateMoovMoneyFirebaseStatus($request, $status, $message)
    {
        try {
            $updateData = [
                'status' => $status,
                'moov_money_status' => $status,
                'updated_at' => now()->timestamp,
                
                // ✅ Toujours inclure le montant et les infos Moov Money
                'moov_money_amount' => $request->moov_money_amount,
                'moov_money_type' => $request->moov_money_type,
                'moov_money_phone' => $request->moov_money_phone,
            ];
            
            // Ajouter les infos du driver si assigné
            if ($request->driver_id && $request->driverDetail) {
                $updateData['driver_id'] = $request->driver_id;
                $updateData['driver_name'] = $request->driverDetail->user->name ?? 'Agent';
                $updateData['driver_phone'] = $request->driverDetail->user->mobile ?? '';
            }
            
            // Ajouter des champs spécifiques selon le statut
            switch ($status) {
                case 'accepted':
                    $updateData['is_accepted'] = 1;
                    $updateData['accepted_at'] = now()->timestamp;
                    break;
                    
                case 'arrived':
                    $updateData['is_driver_arrived'] = 1;
                    $updateData['arrived_at'] = now()->timestamp;
                    break;
                    
                case 'processing':
                    $updateData['is_driver_started'] = 1;
                    break;
            }
            
            // Mettre à jour Firebase
            $this->database->getReference('requests/' . $request->id)->update($updateData);
            
            // Envoyer notification push au user
            $user = $request->userDetail;
            if ($user && $user->fcm_token) {
                $this->sendPushNotification(
                    $user->fcm_token,
                    'Moov Money - ' . ucfirst($request->moov_money_type),
                    $message,
                    [
                        'notification_type' => 'moov_money_status_update',
                        'request_id' => $request->id,
                        'status' => $status,
                        'message' => $message,
                    ]
                );
            }
            
            Log::info('✅ Moov Money Firebase status updated', [
                'request_id' => $request->id,
                'status' => $status,
            ]);
            
        } catch (\Exception $e) {
            Log::error('❌ Failed to update Moov Money Firebase status', [
                'error' => $e->getMessage(),
                'request_id' => $request->id,
                'status' => $status,
            ]);
        }
    }
    
    /**
     * Notifier le user du changement de statut via Firebase
     * 
     * @param Request $request
     * @param string $status
     * @param string $message
     * @return void
     */
    private function notifyUserStatusChange($request, $status, $message)
    {
        try {
            $user = $request->userDetail;
            
            if (!$user || !$user->fcm_token) {
                Log::warning('Cannot send notification: user or FCM token missing', [
                    'request_id' => $request->id,
                    'user_id' => $request->user_id,
                ]);
                return;
            }
            
            $notificationData = [
                'notification_type' => 'moov_money_status_update',
                'request_id' => $request->id,
                'request_number' => $request->request_number,
                'moov_money_type' => $request->moov_money_type,
                'moov_money_status' => $status,
                'moov_money_amount' => $request->moov_money_amount,
                'message' => $message,
                'timestamp' => now()->toIso8601String(),
            ];
            
            // Mettre à jour Firebase avec les deux champs de statut
            $this->database->getReference('requests/' . $request->id)
                ->update([
                    'moov_money_status' => $status,
                    'status' => $status, // Pour compatibilité avec l'app driver
                    'is_completed' => $status === 'completed' ? 1 : 0,
                    'is_cancelled' => $status === 'cancelled' ? 1 : 0,
                    'updated_at' => now()->timestamp,
                    
                    // ✅ Toujours inclure le montant
                    'moov_money_amount' => $request->moov_money_amount,
                    'moov_money_type' => $request->moov_money_type,
                    'moov_money_phone' => $request->moov_money_phone,
                ]);
            
            // Envoyer la notification push
            $this->sendPushNotification(
                $user->fcm_token,
                'Moov Money - ' . ucfirst($request->moov_money_type),
                $message,
                $notificationData
            );
            
            Log::info('Moov Money status notification sent', [
                'request_id' => $request->id,
                'user_id' => $user->id,
                'status' => $status,
            ]);
            
        } catch (\Exception $e) {
            Log::error('Failed to send Moov Money status notification', [
                'error' => $e->getMessage(),
                'request_id' => $request->id,
            ]);
        }
    }
    
    /**
     * Envoyer une notification push via FCM
     * 
     * @param string $fcmToken
     * @param string $title
     * @param string $body
     * @param array $data
     * @return void
     */
    private function sendPushNotification($fcmToken, $title, $body, $data = [])
    {
        try {
            $messaging = app('firebase.messaging');
            
            $message = \Kreait\Firebase\Messaging\CloudMessage::withTarget('token', $fcmToken)
                ->withNotification([
                    'title' => $title,
                    'body' => $body,
                ])
                ->withData($data);
            
            $messaging->send($message);
            
        } catch (\Exception $e) {
            Log::error('Failed to send FCM notification', [
                'error' => $e->getMessage(),
                'fcm_token' => substr($fcmToken, 0, 20) . '...',
            ]);
        }
    }
    
    /**
     * Récupérer les détails d'une requête MoovMoney (pour polling)
     * 
     * @param string $requestId
     * @return \Illuminate\Http\JsonResponse
     */
    public function getRequest($requestId)
    {
        $driver = auth()->user()->driver;

        // Vérifier que la requête existe et est assignée au driver
        $moovRequest = Request::where('id', $requestId)
            ->where('driver_id', $driver->id)
            ->where('is_moov_money', 1)
            ->first();

        if (!$moovRequest) {
            return $this->respondNotFound('Requête non trouvée ou non assignée à ce driver');
        }

        return $this->respondSuccess([
            'id' => $moovRequest->id,
            'status' => $moovRequest->is_completed ? 'completed' : ($moovRequest->is_cancelled ? 'cancelled' : 'pending'),
            'moov_money_status' => $moovRequest->moov_money_status,
            'moov_money_type' => $moovRequest->moov_money_type,
            'amount' => $moovRequest->moov_money_amount,
            'phone' => $moovRequest->moov_money_phone,
            'is_completed' => $moovRequest->is_completed,
            'is_cancelled' => $moovRequest->is_cancelled,
        ]);
    }

    /**
     * Supprimer la requête de Firebase après complétion
     * 
     * @param Request $request
     * @return void
     */
    private function removeRequestFromFirebase($request)
    {
        try {
            // Supprimer la requête de la liste des requêtes en attente
            $this->database->getReference('requests/' . $request->id)->remove();
            
            // Supprimer les requestMeta (rotation des drivers)
            $request->requestMeta()->delete();
            
            Log::info('Request removed from Firebase after completion', [
                'request_id' => $request->id,
                'type' => $request->moov_money_type,
            ]);
            
        } catch (\Exception $e) {
            Log::error('Failed to remove request from Firebase', [
                'error' => $e->getMessage(),
                'request_id' => $request->id,
            ]);
        }
    }
}
